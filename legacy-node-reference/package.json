{
  "name": "jalur-central-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend terpusat JALUR dengan autentikasi berbasis sesi dan kontrol akses per peran",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/security.js && node --check src/routes.js",
    "bootstrap-admin": "node src/bootstrap-admin.js",
    "import-directory": "node src/import-directory.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  }
}
