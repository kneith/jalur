NODE_ENV=development
POSTGRES_PASSWORD=REPLACE_WITH_LONG_DATABASE_PASSWORD
PORT=8080
DATABASE_URL=postgres://jalur:change-this-password@localhost:5432/jalur
# Wajib 32 byte dalam base64. Buat dengan: openssl rand -base64 32
VENTING_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Wajib panjang acak minimal 32 karakter; gunakan nilai rahasia baru
SESSION_PEPPER=REPLACE_WITH_LONG_RANDOM_SECRET
# Set ke origin frontend yang tepat saat deploy, tanpa slash akhir
FRONTEND_ORIGIN=http://localhost:5500
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
