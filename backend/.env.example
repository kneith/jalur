# Copy to backend/.env. Relative dataset paths resolve from repository root.
DATABASE_URL=postgresql://jalur:change-me@localhost:5432/jalur
SESSION_PEPPER=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
JALUR_DIRECTORY_FILE=data/database.js
# Set to postgres only after importing directory rows with scripts/import_directory.py
DIRECTORY_BACKEND=json
